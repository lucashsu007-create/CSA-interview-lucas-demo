# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
out/
*.tsbuildinfo

# Expo / React Native
.expo/
.expo-shared/
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Environment and secrets
.env
.env.*
!.env.example
*.pem

# Local data — never commit member, ticket, or payment data
*.db
*.sqlite
cache/
exports/
supabase/.branches/
supabase/.temp/

# Test and coverage output
coverage/
test-results/
playwright-report/
