# Editor / OS
.DS_Store
Thumbs.db
.idea/
.vscode/

# Python bytecode — the migration skill's reconciler is stdlib Python, and
# running its tests leaves these behind.
__pycache__/
*.pyc

# Generated legacy extract. `pnpm fixtures:generate` rebuilds it byte-for-byte
# from a seed, so the files are an artefact rather than a source, and a 200 kB
# XML export in the diff hides the code that produced it.
fixtures/
