# apps/admin — the committee portal, which also serves the JSON API the Expo
# member app consumes (contract sections 10 and 13).
#
# Copy to `.env.local` if you need to override anything. Nothing here is
# required for a local demo: `@csa/api-client` already defaults to the README's
# `createdb csa_dev` database, and the session signer falls back to a published
# development secret (and says so, loudly, on first use).
#
# NEVER put a real credential in this file. `.env.local` is gitignored;
# `.env.example` is not.

# The database. Read by @csa/api-client, which lifts a `?host=/tmp`-style unix
# socket out of the query string into the driver's own option — libpq accepts
# that spelling and the `postgres` driver does not.
# CSA_DATABASE_URL=postgresql:///csa_dev?host=/tmp

# HS256 key for the seeded-session JWT (contract section 11). 32 characters or
# more. Unset means the public development fallback, which is forgeable.
# CSA_SESSION_SECRET=

# Session lifetime in seconds. Default 3600.
# CSA_SESSION_TTL_SECONDS=3600

# Demo auto-login. Unset (the default) means the portal opens as a guest and you
# pick an identity from the switcher. Set to one of the four fictional
# identities in contract section 7 and the portal signs itself in as that one on
# first visit, which is what a hands-free demo wants.
#
# Signing out still works: it is remembered for the rest of the browser session.
#
# Anyone who can reach the portal gets this identity, so do not point it at an
# admin on a surface you would not hand an admin session to.
# CSA_DEMO_AUTOLOGIN=admin@demo.local
