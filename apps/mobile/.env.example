# The JSON API the member app consumes is served by the Next.js committee portal
# (`apps/admin`) at the routes in docs/architecture.md section 13.
#
# Copy to `.env.local` and set this if the portal is not reachable at
# http://<the machine running Metro>:3000. When it is unset the app derives the
# host from Metro's own connection at runtime, so a phone on the same network
# finds the portal without anyone editing a file. See lib/config.ts.
#
# EXPO_PUBLIC_ prefixed variables are inlined into the bundle by Expo, so this
# holds a base URL and never a secret.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
